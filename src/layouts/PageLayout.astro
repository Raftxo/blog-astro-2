---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
	wide?: boolean;
	image?: ImageMetadata;
	imageAlt?: string;
	noindex?: boolean;
}

const { title, description, wide = false, image, imageAlt, noindex = false } = Astro.props;
---

<BaseLayout {title} {description} {image} {imageAlt} {noindex}>
	<main id="contenido" class:list={[{ wide }]}>
		<slot />
	</main>
</BaseLayout>
