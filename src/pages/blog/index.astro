---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout title="Bitácora" description="Entradas de The Silent Pulse." wide>
	<h1>Bitácora</h1>
	<p>Lo que he aprendido, lo que estoy probando y lo que aún no sé explicar del todo.</p>
	<ul class="post-grid">
		{posts.map((post) => <PostCard post={post} />)}
	</ul>
</PageLayout>

<style>
	h1 {
		text-align: center;
	}
	p {
		text-align: center;
		color: rgb(var(--gray));
	}
	ul.post-grid {
		margin-top: 2em;
	}
</style>
