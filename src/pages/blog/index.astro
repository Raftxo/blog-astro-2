---
import PostCard from '../../components/PostCard.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<PageLayout title="Bitácora" description="Notas sobre código, atención y calma digital." wide>
	<h1>Bitácora</h1>
	<p>Lo que he aprendido, lo que estoy probando y lo que aún no sé explicar del todo.</p>
	{
		posts.length > 0 ? (
			<ul class="post-grid">
				{posts.map((post, index) => (
					<PostCard post={post} headingLevel={2} priority={index === 0} />
				))}
			</ul>
		) : (
			<p>Todavía no hay entradas publicadas.</p>
		)
	}
</PageLayout>

<style>
	h1 {
		text-align: center;
	}
	p {
		text-align: center;
		color: rgb(var(--gray));
	}
	ul.post-grid {
		margin-top: 2em;
	}
</style>
