---
import PageLayout from '../layouts/PageLayout.astro';
import { withBase } from '../lib/url';
---

<PageLayout
	title="Página no encontrada"
	description="La página que buscas no existe o ha cambiado de sitio."
	noindex
>
	<section class="not-found">
		<p class="code" aria-hidden="true">404</p>
		<h1>Esta página no existe</h1>
		<p>
			Puede que el enlace esté mal escrito o que la entrada haya cambiado de sitio. Desde aquí
			puedes volver al inicio o seguir leyendo en la bitácora.
		</p>
		<p class="actions">
			<a href={withBase('')}>Volver al inicio</a>
			<span aria-hidden="true">·</span>
			<a href={withBase('blog/')}>Ir a la bitácora</a>
		</p>
	</section>
</PageLayout>

<style>
	.not-found {
		text-align: center;
	}
	.code {
		margin: 0;
		color: rgb(var(--gray));
		font-size: clamp(5rem, 18vw, 10rem);
		font-weight: 700;
		line-height: 1;
	}
	.not-found p {
		max-width: 55ch;
		margin-right: auto;
		margin-left: auto;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em;
		margin-top: 1.5em;
	}
</style>
