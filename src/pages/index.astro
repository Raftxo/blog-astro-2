---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PostCard from '../components/PostCard.astro';
import { BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 3);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>¡Bienvienid@!</h1>
		<p>
			Este es <strong>The Silent Pulse</strong>, el rincón de Raftxo para dejar constancia de las
			ideas que no hacen ruido pero insisten en volver: código, música ambiente, libros a medias
			y pequeños rituales para prestar atención.
		</p>
		<p>
			Aquí escribo sobre lo que aprendo construyendo cosas para la web y sobre lo que descubro
			cuando bajo el volumen. Si te quedas un rato, ojalá encuentres algo que te suene conocido.
		</p>
		<p class="actions">
			<a href={`${BASE}blog/`}>Entrar en la bitácora</a>
			<span aria-hidden="true">·</span>
			<a href={`${BASE}about/`}>Conocer a Raftxo</a>
		</p>
	</section>

	<h2>Últimas entradas</h2>
	<ul class="post-grid">
		{recentPosts.map((post) => <PostCard post={post} />)}
	</ul>
</PageLayout>

<style>
	.intro h1 {
		margin-bottom: 0.4em;
	}
	.intro p {
		max-width: 62ch;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-top: 1.5em;
	}
	h2 {
		margin-top: 2em;
		margin-bottom: 1em;
	}
</style>
