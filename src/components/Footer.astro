---
import { AUTHOR, BASE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {AUTHOR}. Todos los derechos reservados.</p>
	<div class="social-links">
		<SocialLinks />
		<a class="rss-link" href={`${BASE}rss.xml`}>RSS</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray-dark));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links :global(a) {
		display: flex;
		color: inherit;
		text-decoration: none;
	}
	.social-links :global(a:hover) {
		color: var(--accent);
	}
	.rss-link {
		font-size: 0.9em;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
</style>
