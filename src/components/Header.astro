---
import { BASE, SITE_NAME } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header>
	<nav aria-label="Navegación principal">
		<a class="brand" href={BASE}>{SITE_NAME}</a>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog/">Bitácora</HeaderLink>
			<HeaderLink href="/about/">Sobre mí</HeaderLink>
		</div>
		<div class="social-links">
			<SocialLinks />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.brand {
		padding: 1em 0.5em 1em 0;
		font-weight: 700;
		white-space: nowrap;
	}
	nav a.active {
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.social-links {
		display: flex;
		align-items: center;
	}
	.social-links :global(a) {
		display: flex;
		color: rgb(var(--black));
	}
	.social-links :global(a:hover) {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0;
			padding: 0.25em 0 0.4em;
		}
		nav a.brand {
			flex: 1 0 100%;
			padding: 0.7em 0 0.2em;
			text-align: center;
		}
		.internal-links {
			width: 100%;
			justify-content: center;
			flex-wrap: wrap;
		}
		.internal-links a {
			padding: 0.45em 0.55em;
			font-size: 0.95em;
		}
		.social-links {
			display: none;
		}
	}
</style>
